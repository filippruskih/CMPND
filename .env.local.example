# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — this .example file is not, so never put real
# secrets in this file itself.
# See the Settings page in the app for step-by-step setup instructions.

# Postgres connection string (e.g. from Railway's Postgres plugin, or any
# other Postgres host). Required — there is no SQLite fallback.
DATABASE_URL=

# From the Instagram Graph API use case's "API setup with Instagram Login"
# page in your Meta app (NOT the app's generic Basic Settings page).
IG_APP_ID=
IG_APP_SECRET=

# Instagram's Business Login requires HTTPS, even for localhost. Must
# exactly match a redirect URI registered on that same setup page, and you
# must run `npm run dev:https` (not `npm run dev`) for this to actually work
# locally — plain http will not work, and Meta will reject a plain-http URI
# when you try to save it.
IG_REDIRECT_URI=https://localhost:3000/api/instagram/callback

# From console.anthropic.com — used to auto-classify each reel's format/topics
# during sync, and to run the daily content agents.
ANTHROPIC_API_KEY=

# Optional — only needed for the DM Manager agent (see the DMs page for full
# setup). Any string you choose; must match the verify token you configure
# on the webhook subscription in the Meta app dashboard.
IG_WEBHOOK_VERIFY_TOKEN=

# Optional — once set, every page (except the Instagram webhook) requires
# this password via a browser Basic Auth prompt. Leave blank for open local
# dev; set this when hosting the app publicly.
SITE_PASSWORD=

# Optional — where the Scanner feature stores uploaded draft-reel videos.
# In production, set this to match the mount path of a Railway Volume
# attached to this service (e.g. "/data/drafts") so drafts survive
# redeploys. Leave blank locally — falls back to ./.data/drafts.
DRAFTS_DIR=

# Optional — email delivery for the Daily report agent. Leave both blank to
# keep daily reports in-app only. Get an API key from resend.com (free tier
# covers one email/day many times over).
RESEND_API_KEY=
# Your own email address - where daily reports get sent.
REPORT_EMAIL_TO=
# Optional - defaults to Resend's shared test sender, which works with no
# setup but looks like it (onboarding@resend.dev). Verify your own domain
# in Resend to use a real "from" address instead, e.g.
# "CMPND <reports@yourdomain.com>".
REPORT_FROM_EMAIL=
